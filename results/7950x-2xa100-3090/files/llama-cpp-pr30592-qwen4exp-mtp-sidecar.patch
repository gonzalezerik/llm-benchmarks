From 1af38b36cc12f5d1618dc1126b21aaf1a412f092 Mon Sep 17 00:00:00 2001
From: GlassOnTin <GlassOnTin@users.noreply.github.com>
Date: Sun, 4 Oct 2026 14:28:10 +0100
Subject: [PATCH 1/2] llama: skip sidecar scale/input_scale tensors alongside
 skipped weight tensors

---
 src/llama-model-loader.cpp | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index bc93c6f9e62d..8d5292ac191b 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1177,11 +1177,24 @@ struct ggml_tensor * llama_model_loader::create_tensor(
 
         // skip unused tensors
         if (info.op == GGML_OP_NONE || (flags & TENSOR_SKIP)) {
-            const size_t nbytes = ggml_nbytes(t_meta);
-            LLAMA_LOG_WARN("model has unused tensor %s (size = %zu bytes) -- ignoring\n", tn.str().c_str(), nbytes);
+            auto skip_tensor = [&](const ggml_tensor * tensor) {
+                const size_t nbytes = ggml_nbytes(tensor);
+                LLAMA_LOG_WARN("model has unused tensor %s (size = %zu bytes) -- ignoring\n", tensor->name, nbytes);
 
-            size_data -= nbytes;
-            n_created++;
+                size_data -= nbytes;
+                n_created++;
+            };
+
+            skip_tensor(t_meta);
+
+            if ((flags & TENSOR_SKIP) && tn.suffix && strcmp(tn.suffix, "weight") == 0) {
+                for (const char * suffix : { "scale", "input_scale" }) {
+                    const LLM_TN_IMPL sidecar_tn(tn.arch, tn.tensor, suffix, tn.bid, tn.xid);
+                    if (const ggml_tensor * sidecar = get_tensor_meta(sidecar_tn.str().c_str())) {
+                        skip_tensor(sidecar);
+                    }
+                }
+            }
 
             return nullptr;
         }

From 98fd535f104720d35eed43d127dd83013aafabed Mon Sep 17 00:00:00 2001
From: GlassOnTin <GlassOnTin@users.noreply.github.com>
Date: Sun, 4 Oct 2026 15:43:33 +0100
Subject: [PATCH 2/2] qwen4exp: fix nextn head-mixer fallback and MTP kpool
 graph inputs

Two independent issues hit when serving the 125B Flash-Next with the
MTP (nextn) block, via either the mtp-only sidecar GGUF or a base GGUF
with the block merged in:

- the head mixer tensors: reference checkpoints duplicate the trunk
  head mixer as nextn.hc_head_*, other exporters share the trunk
  down/up weights and name the per-block norm shared_head_norm
  (original HF name). Make nextn.hc_head_* NOT_REQUIRED and fall back
  to shared_head_norm, then to the trunk weights.
- graph_mtp built the kpool input bundle unconditionally, but the MTP
  block is not a QSA layer (compress_ratios[nextn] = 0 in the tested
  exports), so nothing consumes k_idxs / new_pool_* and the gallocr
  leaves them unallocated; llm_graph_input_kpool::set_input then
  touched unallocated tensors and the draft context canary decode
  aborted on GGML_ASSERT(ggml_backend_buffer_is_device...buffer).
  Only build kpool inputs when the block actually pools, and guard
  set_input with the ->buffer checks the input contract in
  llama-graph.cpp requires for bypassed-cache inputs.

Test: Qwen3.8-Flash-Next 125B (UD-Q4_K_XL + merged Q4_K_M MTP block)
on 3x RTX 5090, --spec-type draft-mtp at n_ctx 262144. Before: assert
aborting the draft context creation. After: server loads and serves
with draft acceptance 0.74 per request on code prompts.
---
 src/models/qwen4exp.cpp | 38 +++++++++++++++++++++++++++++++-------
 1 file changed, 31 insertions(+), 7 deletions(-)

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index e055abdf55d2..4ea26bcc6a52 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -295,9 +295,25 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
         nextn.enorm        = create_tensor(tn(LLM_TENSOR_NEXTN_ENORM,        "weight", il), { n_embd }, mtp_flags);
         // RMS per hc stream of the trunk residual, so the gammas load as [n_embd, hc] like the mixer norms
         nextn.hnorm        = create_tensor(tn(LLM_TENSOR_NEXTN_HNORM,        "weight", il), { n_embd, hc }, mtp_flags | TENSOR_ALLOW_RESHAPE);
-        nextn.hc_head_norm = create_tensor(tn(LLM_TENSOR_NEXTN_HC_HEAD_NORM, "weight", il), { n_embd, hc }, mtp_flags | TENSOR_ALLOW_RESHAPE);
-        nextn.hc_head_down = create_tensor(tn(LLM_TENSOR_NEXTN_HC_HEAD_DOWN, "weight", il), { hc_dim, hc_lr }, mtp_flags);
-        nextn.hc_head_up   = create_tensor(tn(LLM_TENSOR_NEXTN_HC_HEAD_UP,   "weight", il), { hc_lr, hc_dim }, mtp_flags);
+        // the MTP head mixer: reference checkpoints carry a per-block copy of
+        // the trunk head mixer (output_hc_* duplicated as nextn.hc_head_*),
+        // while other exporters share the trunk down/up and name the per-block
+        // norm shared_head_norm (original HF name). Accept whichever is present.
+        nextn.hc_head_norm = create_tensor(tn(LLM_TENSOR_NEXTN_HC_HEAD_NORM,    "weight", il), { n_embd, hc }, mtp_flags | TENSOR_ALLOW_RESHAPE | TENSOR_NOT_REQUIRED);
+        nextn.hc_head_down = create_tensor(tn(LLM_TENSOR_NEXTN_HC_HEAD_DOWN,    "weight", il), { hc_dim, hc_lr }, mtp_flags | TENSOR_NOT_REQUIRED);
+        nextn.hc_head_up   = create_tensor(tn(LLM_TENSOR_NEXTN_HC_HEAD_UP,      "weight", il), { hc_lr, hc_dim }, mtp_flags | TENSOR_NOT_REQUIRED);
+        if (!nextn.hc_head_norm) {
+            nextn.hc_head_norm = create_tensor(tn(LLM_TENSOR_NEXTN_SHARED_HEAD_NORM, "weight", il), { n_embd, hc }, mtp_flags | TENSOR_NOT_REQUIRED | TENSOR_ALLOW_RESHAPE);
+        }
+        if (!nextn.hc_head_norm) {
+            nextn.hc_head_norm = hc_head_norm;
+        }
+        if (!nextn.hc_head_down) {
+            nextn.hc_head_down = hc_head_down;
+        }
+        if (!nextn.hc_head_up) {
+            nextn.hc_head_up = hc_head_up;
+        }
     }
 }
 
@@ -569,7 +585,9 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
     ggml_build_forward_expand(gf, inp_hyb->get_recr()->s_copy);
 
     llm_graph_input_kpool * inp_kpool = nullptr;
-    if (mctx_hyb->get_idx() && hparams.indexer_kpool > 0) {
+    // the MTP block is not a QSA layer, so nothing in this graph would read the
+    // kpool tensors and they would go unallocated -- only build them when it pools
+    if (mctx_hyb->get_idx() && hparams.indexer_kpool > 0 && hparams.dsv4_compress_ratios[il] > 0) {
         GGML_ASSERT(mctx_hyb->get_idx()->get_n_kv() == mctx_hyb->get_attn()->get_n_kv() &&
                 "the indexer cache must track the attention cache cell for cell");
         inp_kpool = build_inp_kpool(mctx_hyb);
@@ -650,9 +668,15 @@ class llama_model_qwen4exp::llm_graph_input_kpool : public llm_graph_input_i {
     virtual ~llm_graph_input_kpool() = default;
 
     void set_input(const llama_ubatch * ubatch) override {
-        mctx->get_idx()->set_input_k_idxs(k_idxs, ubatch);
-        mctx->set_input_kpool(pool_cells, pool_idxs, pool_mask, tail_idxs, nullptr, new_pool_idxs, new_pool_rep,
-                              ubatch, new_pool_pos);
+        // k_idxs and the new-pool tensors can be left unallocated when the graph
+        // has no QSA layer to consume them, like the KV cache bypassed during training
+        if (k_idxs && k_idxs->buffer) {
+            mctx->get_idx()->set_input_k_idxs(k_idxs, ubatch);
+        }
+        if (new_pool_idxs && new_pool_idxs->buffer) {
+            mctx->set_input_kpool(pool_cells, pool_idxs, pool_mask, tail_idxs, nullptr, new_pool_idxs, new_pool_rep,
+                                  ubatch, new_pool_pos);
+        }
     }
 
     bool can_reuse(const llm_graph_params & params) override {
