# CUDA toolchain for Project Maya and Strata (2x A100 SXM4 40GB sm_80 + RTX 3090 sm_86).
# 13.4.3 matches the host driver 615 / CUDA user-mode driver 13.4.
# The source trees are bind-mounted at the same path they run from, not baked in.
FROM docker.io/nvidia/cuda:13.4.3-devel-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev python3-pip cmake ninja-build git build-essential ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
